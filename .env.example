# Скопировать в .env на хосте бота и заполнить. В git/чаты не коммитить.

# --- Портал (Discourse) ---
# Гранулярный API-ключ: Admin → API → New Key.
# Пользователь: staff-бот (например support_bot) — от его имени идут скрытые
# сообщения и назначения. Скоупы: Data Explorer «run queries» (запросы 53, 54)
# + Assign «assign». Больше ничего не давать.
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=support_bot
PORTAL_URL=https://support.wirenboard.com

# Режим работы. Пусто = из routing.yaml (сейчас assign). Переключение без правки кода:
#   BOT_MODE=suggest — только скрытые подсказки; BOT_MODE=assign — реально назначает; BOT_MODE=off — выкл.
BOT_MODE=

# --- ИИ-оператор (bot.brain: ai) ---
# Любой OpenAI-совместимый endpoint. Пусто — бот молча работает на правилах.
#
# GPT-5 (рекомендация для этой задачи — чат-версия, быстрая, поддерживает JSON):
#   AI_MODEL=gpt-5.6-sol
# Если хочется, чтобы «думала» (reasoning-версия) — дороже и медленнее на каждой теме:
#   AI_MODEL=<актуальный reasoning-id из доков OpenAI>  +  AI_REASONING_EFFORT=low|medium|high
# DeepSeek: AI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
#
# AI_TEMPERATURE слать НЕ обязательно (и НЕ для reasoning-моделей GPT-5 — они его отклонят).
# Оставь пустым — используется дефолт модели.
AI_API_KEY=
AI_MODEL=gpt-5.6-sol
AI_BASE_URL=https://api.openai.com
AI_TEMPERATURE=
AI_REASONING_EFFORT=
